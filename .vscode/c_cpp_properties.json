{
    "configurations": [
        {
            "name": "EDU-CIAA-PORTABLE",
            "includePath": [
                "${workspaceFolder}/libs/**",
                "${workspaceFolder}/libs/lpc_open/lpc_chip_43xx/inc",
                "${workspaceFolder}/libs/lpc_open/boards/edu_ciaa_nxp/inc",
                "${workspaceFolder}/libs/cmsis_core/inc",
                "${workspaceFolder}/projects/**" 
            ],
            "defines": [
                "CORE_M4",
                "CHIP_LPC43XX",
                "__USE_LPCOPEN",
                "BOARD=edu_ciaa_nxp",
                "__GNUC__"
            ],
            /* Encapsulamos la ruta entre comillas dobles por los espacios en el nombre de usuario */
            "compilerPath": "${workspaceFolder}/tools/gcc-arm/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}/libs",
                    "${workspaceFolder}/projects"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ],
    "version": 4
}