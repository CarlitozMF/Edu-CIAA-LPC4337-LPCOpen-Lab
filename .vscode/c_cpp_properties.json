{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${fileDirname}/../Inc",
                "${fileDirname}",
                "${workspaceFolder}/libs/custom_drivers/**",
                "${workspaceFolder}/libs/lpc_open/lpc_chip_43xx/inc",
                "${workspaceFolder}/libs/lpc_open/lpc_chip_43xx/inc/usbd_rom",
                "${workspaceFolder}/libs/cmsis_core/inc",
                "${workspaceFolder}/libs/startup/inc",
                "${workspaceFolder}/libs/**"
            ],
            "defines": [
                "CORE_M4",
                "CHIP_LPC43XX",
                "__USE_LPCOPEN",
                "BOARD=edu_ciaa_nxp",
                "__GNUC__"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfloat-abi=hard",
                "-mfpu=fpv4-sp-d16"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/libs",
                    "${workspaceFolder}/projects"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "Win32",
            "includePath": [
                "${fileDirname}/../Inc",
                "${fileDirname}",
                "${workspaceFolder}/libs/custom_drivers/**",
                "${workspaceFolder}/libs/lpc_open/lpc_chip_43xx/inc",
                "${workspaceFolder}/libs/lpc_open/lpc_chip_43xx/inc/usbd_rom",
                "${workspaceFolder}/libs/cmsis_core/inc",
                "${workspaceFolder}/libs/startup/inc",
                "${workspaceFolder}/libs/**"
            ],
            "defines": [
                "CORE_M4",
                "CHIP_LPC43XX",
                "__USE_LPCOPEN",
                "BOARD=edu_ciaa_nxp",
                "__GNUC__"
            ],
            "compilerPath": "${workspaceFolder}/tools/gcc-arm/bin/arm-none-eabi-gcc.exe",
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfloat-abi=hard",
                "-mfpu=fpv4-sp-d16"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/libs",
                    "${workspaceFolder}/projects"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}