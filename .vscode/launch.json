{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐞 DEBUG (EDU-CIAA)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${workspaceFolder}/out/${input:projectName}/${input:projectName}.elf",
            "armToolchainPath": "${workspaceFolder}/tools/gcc-arm/bin",
            "gdbPath": "${workspaceFolder}/tools/gcc-arm/bin/arm-none-eabi-gdb.exe",
            "cwd": "${workspaceFolder}",
            "svdFile": "${workspaceFolder}/misc/LPC43xx_43Sxx.svd",
            "device": "LPC4337", 
            "runToEntryPoint": "main",
            "preLaunchTask": "🛠️ MAKE BUILD", 
            "configFiles": [
                "${workspaceFolder}/misc/lpc4337.cfg"
            ],
            "serverpath": "${workspaceFolder}/tools/openocd/bin/openocd.exe", 
            "serverArgs": [
                "-s", "${workspaceFolder}/tools/openocd/scripts"
            ],
            "overrideLaunchCommands": [
                "monitor reset halt",
                "load",
                "tbreak main"
            ],
            "postLaunchCommands": [
                "monitor reset init",
                "monitor halt"
            ],
            // Esto ayuda a que las vistas de registros se activen correctamente
            "numberOfProcessors": 1,
            "targetAttributes": {
                "core": "Cortex-M4"
            }
        }
    ],
    "inputs": [
        {
            "id": "projectName",
            "type": "pickString",
            "description": "Seleccioná el proyecto para depurar:",
            "options": [
                "01_GPIO",
                "02_GPIO_Abstraction",
                "03_External_Counter_MEF"
            ],
            "default": "01_GPIO"
        }
    ]
}