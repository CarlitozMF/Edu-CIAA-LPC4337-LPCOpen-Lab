{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "bash.exe",
                "args": ["-c"]
            }
        }
    },
    "linux": {
        "options": {
            "shell": {
                "executable": "/bin/bash",
                "args": ["-c"]
            }
        }
    },
    "tasks": [
        {
            "label": "🛠️ MAKE BUILD",
            "type": "shell",
            "command": "dir=\"${fileDirname}\"; while [ \"$dir\" != \"/\" ] && [ ! -f \"$dir/Makefile\" ]; do dir=$(dirname \"$dir\"); done; make --no-print-directory -C \"$dir\" -j4",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🚀 MAKE FLASH",
            "type": "shell",
            "command": "dir=\"${fileDirname}\"; while [ \"$dir\" != \"/\" ] && [ ! -f \"$dir/Makefile\" ]; do dir=$(dirname \"$dir\"); done; make --no-print-directory -C \"$dir\" flash",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🧹 MAKE CLEAN",
            "type": "shell",
            "command": "dir=\"${fileDirname}\"; while [ \"$dir\" != \"/\" ] && [ ! -f \"$dir/Makefile\" ]; do dir=$(dirname \"$dir\"); done; make --no-print-directory -C \"$dir\" clean",
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🐞 MAKE DEBUG (Server)",
            "type": "shell",
            "command": "dir=\"${fileDirname}\"; while [ \"$dir\" != \"/\" ] && [ ! -f \"$dir/Makefile\" ]; do dir=$(dirname \"$dir\"); done; make --no-print-directory -C \"$dir\" debug",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Iniciando servidor",
                    "endsPattern": "Esperando conexión"
                }
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ]
}