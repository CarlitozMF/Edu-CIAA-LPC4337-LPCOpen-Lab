{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🛠️ MAKE BUILD",
            "type": "shell",
            "command": "make",
            "args": [
                "PROJECT=${input:projectName}",
                "-j4"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "bash.exe",
                        "args": ["-c"]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🚀 MAKE FLASH",
            "type": "shell",
            "command": "make",
            "args": [
                "PROJECT=${input:projectName}",
                "flash"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "bash.exe",
                        "args": ["-c"]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "🧹 MAKE CLEAN",
            "type": "shell",
            "command": "make",
            "args": [
                "PROJECT=${input:projectName}",
                "clean"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "bash.exe",
                        "args": ["-c"]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": "$gcc",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🐞 MAKE DEBUG (Server)",
            "type": "shell",
            "command": "make",
            "args": [
                "PROJECT=${input:projectName}",
                "debug"
            ],
            "windows": {
                "options": {
                    "shell": {
                        "executable": "bash.exe",
                        "args": ["-c"]
                    }
                }
            },
            "linux": {
                "options": {
                    "shell": {
                        "executable": "/bin/bash",
                        "args": ["-c"]
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Iniciando servidor",
                    "endsPattern": "Esperando conexión"
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "projectName",
            "type": "pickString",
            "description": "Seleccioná el laboratorio a procesar:",
            "options": [
                "01_GPIO",
                "02_GPIO_Abstraction",
                "03_External_Counter_MEF"
            ],
            "default": "01_GPIO"
        }
    ]
}